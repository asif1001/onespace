rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user is driver
    function isDriver() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver';
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection rules
    match /users/{userId} {
      // Users can read their own document, admins can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can update their own basic info, admins can update any user
      allow update: if (isOwner(userId) && 
                       !('role' in request.resource.data.diff(resource.data).affectedKeys())) ||
                      isAdmin();
      
      // Only admins can create and delete users
      allow create, delete: if isAdmin();
    }

    // Deliveries collection rules
    match /deliveries/{deliveryId} {
      // Drivers can read their own deliveries, admins can read all
      allow read: if isAdmin() || 
                     (isDriver() && resource.data.driverId == request.auth.uid);
      
      // Drivers can create new deliveries, admins can create any
      allow create: if isDriver() || isAdmin();
      
      // Drivers can update their own deliveries, admins can update any
      allow update: if isAdmin() || 
                       (isDriver() && resource.data.driverId == request.auth.uid);
      
      // Only admins can delete deliveries
      allow delete: if isAdmin();
    }

    // Complaints collection rules
    match /complaints/{complaintId} {
      // Admins can read all complaints, drivers can read complaints for their deliveries
      allow read: if isAdmin() || 
                     (isDriver() && 
                      get(/databases/$(database)/documents/deliveries/$(resource.data.deliveryId)).data.driverId == request.auth.uid);
      
      // Anyone can create complaints (for customer complaints via drivers)
      allow create: if isAuthenticated();
      
      // Only admins can update and delete complaints
      allow update, delete: if isAdmin();
    }

    // Photos/files in storage (referenced by deliveries)
    match /delivery-photos/{photoId} {
      // Follow same rules as deliveries since photos are linked to deliveries
      allow read, write: if isAuthenticated();
    }

    // Export logs (for tracking CSV exports)
    match /export-logs/{logId} {
      // Only admins can read export logs
      allow read, create: if isAdmin();
    }

    // System settings (app configuration)
    match /settings/{settingId} {
      // Everyone can read settings, only admins can modify
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}